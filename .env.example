# Freebots frontend environment (static GitHub Pages demo).
# Copy to .env for local development. NEVER commit a real .env file.
# The Pages build must not embed secrets — leave these empty for demo mode.

# Optional future backend base URL (e.g. https://api.example.com).
# When empty, the app runs in explicit "Demo / Static Mode" with local sample data.
# VITE_API_URL=
# VITE_API_URL=https://api.example.com

# Optional public site URL override (defaults to GitHub Pages URL).
# VITE_SITE_URL=https://sufiyan-sabeel.github.io/Botslord/
